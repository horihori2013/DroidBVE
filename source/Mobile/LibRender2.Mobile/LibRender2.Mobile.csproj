<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>LibRender2</AssemblyName>
    <RootNamespace>LibRender2</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\LibRender2\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBveApi.Mobile\OpenBveApi.Mobile.csproj" />
    <!-- OpenTK 3.x built from the vendored sources (see ../../externals/OpenTK3/PROVENANCE.md).
         OpenTK3.Mobile exposes the GLES 3.0 surface + the desktop-GL compat shim
         (GLESCompat) - the exact API the Android build uses. -->
    <ProjectReference Include="..\..\..\externals\OpenTK3\OpenTK3.Mobile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TEMPORARY: GDI+ based font/texture handling. To be replaced for Android. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>