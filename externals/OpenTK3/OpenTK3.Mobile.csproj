<!--
  OpenTK 3.3.3 - mobile/anyCPU build for net8.0, OpenGL ES surface.
  Same source set as OpenTK3.Android.csproj except the Mono.Android-dependent
  Platform/Android glue (AndroidGameView etc.), plus the GLESCompat shim which
  re-provides the desktop OpenGL API surface LibRender2 uses, implemented over
  the ES 3.0 bindings (see GLESCompat/GLCompat.cs).

  This is what the mobile core (LibRender2.Mobile etc.) compiles against, so
  the code path matches the Android build exactly.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OpenTK</AssemblyName>
    <RootNamespace>OpenTK</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet dependencies next to OpenTK.dll so the binding rewriter
         (Generator.Rewrite) can resolve them when rewriting the IL. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);NU1701;CS0618;CS1591;CS3021;CS0067;CS0414;CS0169;CS0649</NoWarn>
    <DefineConstants>$(DefineConstants);OPENGLES;OPENTK_1_1;__MOBILE__</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

