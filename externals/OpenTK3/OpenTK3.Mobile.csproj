  <!--
    Rewrite the generated binding stubs (which throw BindingsNotRewrittenException)
    into real interop calls - required for the assembly to work at runtime.
    Uses the vendored Generator.Rewrite tool. Set -p:SkipBindingRewrite=true to skip.
  -->
  <Target Name="RewriteBindings" AfterTargets="Build" Condition="'$(SkipBindingRewrite)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Generator.Rewrite\Generator.Rewrite.NetCore.csproj&quot; --configuration $(Configuration) -- --assembly &quot;$(TargetPath)&quot;" />
  </Target>

